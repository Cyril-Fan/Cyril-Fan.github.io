{
  "name": "cyril-fan-site",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "dev:check": "astro check --watch & astro dev",
    "build:base": "npm run sync:friends && node scripts/sync-contribution-snake.mjs && node scripts/sync-contribution-calendar.mjs && astro check && astro build",
    "build": "npm run build:base",
    "build:vercel": "npm run build:base",
    "build:cloudflare": "npm run build:base",
    "build:github": "npm run build:base",
    "preview": "astro preview",
    "sync": "astro sync",
    "check": "astro check",
    "test": "node --test tests/comment-auth.test.mjs tests/comment-avatar.test.mjs tests/comment-markdown.test.mjs tests/comments-ui.test.mjs tests/theme.test.mjs tests/branding.test.mjs tests/icon-cache.test.mjs tests/contribution-snake.test.mjs tests/github-calendar.test.mjs tests/toc.test.mjs tests/friends.test.mjs tests/site-traffic.test.mjs tests/content-files.test.mjs tests/content-local.test.mjs tests/content-ui.test.mjs tests/content-publisher.test.mjs tests/content-highlight.test.mjs",
    "test:database": "node tests/database/run-security.mjs",
    "test:content": "node scripts/check-content-migration.mjs",
    "astro": "astro",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,md,mdx,astro}'",
    "lint": "eslint --fix 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "lint:check": "eslint 'src/**/*.{js,ts,jsx,tsx,astro}'",
    "type:check": "astro check",
    "quality": "npm run lint && npm run sync && npm run type:check && npm run format",
    "yijiansilian": "npm run quality",
    "clean": "rm -rf .astro .vercel dist .wrangler",
    "clean:all": "npm run clean && rm -rf node_modules",
    "sync:friends": "node scripts/sync-friend-feeds.mjs",
    "avatar:friend": "node scripts/import-friend-avatar.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@jsquash/webp": "1.5.0",
    "@pagefind/default-ui": "^1.4.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "caniuse-lite": "^1.0.30001762",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "5.11.2",
    "hast-util-select": "^6.0.4",
    "katex": "^0.18.10",
    "medium-zoom": "1.1.0",
    "node-html-parser": "^7.0.2",
    "pagefind": "^1.4.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "0.35.5",
    "simple-icons": "^15.22.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@astrojs/markdown-remark": "7.3.3",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.3",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "hastscript": "^9.0.1",
    "jsdom": "26.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype": "^13.0.2",
    "rollup-plugin-visualizer": "^5.14.0",
    "shiki": "4.5.0",
    "typescript-eslint": "8.72.0",
    "ultrahtml": "^1.6.0",
    "unist-util-visit": "^5.0.0",
    "vfile": "^6.0.3"
  },
  "overrides": {
    "sharp": "0.35.5",
    "katex": "$katex",
    "postcss-selector-parser": "7.1.7"
  }
}
