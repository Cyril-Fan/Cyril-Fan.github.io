---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { Comment } from '@/components/advanced'
import { ArticleBottom, Copyright, Hero, TOC } from '@/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import { contentImage } from '../lib/content-image'

interface Props {
  post: CollectionEntry<'blog'> | CollectionEntry<'blogEn'>
  posts: CollectionEntry<'blog'>[] | CollectionEntry<'blogEn'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  post: { id, data, filePath },
  posts,
  headings,
  remarkPluginFrontmatter
} = Astro.props

const {
  description,
  heroImage,
  publishDate,
  title,
  updatedDate,
  draft: isDraft,
  comment: enableComment
} = data

const socialImage = heroImage
  ? typeof heroImage.src === 'string'
    ? contentImage(heroImage.src,filePath)
    : ''
  : '/avatar/avatar.png'
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
const primaryColor = data.heroImage?.color ?? 'hsl(var(--primary) / var(--tw-text-opacity, 1))'
const tocHeadings=[...headings,...(!isDraft&&enableComment?[{depth:2,slug:'comments',text:Astro.currentLocale==='en'?'Conversation':'留言与交流'}]:[])]
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  highlightColor={primaryColor}
  back={Astro.currentLocale === 'en' ? '/en/blog/all' : '/blog/all'}
>
  {!!tocHeadings.length && <TOC headings={tocHeadings} slot='sidebar' />}

  <Hero {data} {filePath} {remarkPluginFrontmatter} slot='header' />

  <slot />

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />
    {/* Comment */}
    {!isDraft && enableComment && <Comment thread={`/blog/${id}`} class='mt-3 sm:mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

