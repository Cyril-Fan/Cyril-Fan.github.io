---
import { getBlogCollection } from '@/utils/server'
import { getReadingTime } from '@/utils/reading-time'
import { Icon } from '@/components/user'
import { siteDaysOnline } from '../../lib/site-days'

interface BlogStatsProps {
  blogStartDate: Date
}

const { blogStartDate } = Astro.props as BlogStatsProps
const startDate = blogStartDate

const allPosts = await getBlogCollection()

const daysDiff = siteDaysOnline(startDate) ?? 0
const english = Astro.currentLocale === 'en'

const articleDates = allPosts.flatMap(post => [post.data.publishDate, post.data.updatedDate])
  .filter((value): value is Date => value instanceof Date && Number.isFinite(value.getTime()))
const lastUpdated = articleDates.length ? new Date(Math.max(...articleDates.map(date => date.getTime()))) : null

let totalWords = 0
for (const post of allPosts) {
  try {
    const { body } = post
    if (body) {
      const readingTime = getReadingTime(body)
      totalWords += readingTime.words
    }
  } catch (error) {
    console.warn(`Error calculating word count for post ${post.id}:`, error)
  }
}

const formatNumber = (num: number) => new Intl.NumberFormat(english ? 'en-US' : 'zh-CN', {
  notation: 'compact',
  maximumFractionDigits: 1
}).format(num)

const formatDate = (date: Date) => {
  return date.toLocaleDateString(english ? 'en-US' : 'zh-CN', {
    timeZone: 'Asia/Shanghai',
    year: 'numeric',
    month: 'short',
    day: 'numeric'
  })
}
---

<div class="flex flex-col gap-y-5">
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-xs transition-all hover:border-foreground/25 hover:shadow-lg">
      <Icon name="time" class="size-5 text-muted-foreground group-hover:text-primary transition-colors" />
      <div class="text-center">
        <site-days data-started={startDate.toISOString()} class="block text-2xl font-bold text-foreground group-hover:text-primary transition-colors">{daysDiff}</site-days>
        <div class="text-sm text-muted-foreground">{english ? 'Days Online' : '建站天数'}</div>
      </div>
    </div>
    
    <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-xs transition-all hover:border-foreground/25 hover:shadow-lg">
      <Icon name="calendar" class="size-5 text-muted-foreground group-hover:text-primary transition-colors" />
      <div class="text-center">
        <div class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">{lastUpdated ? formatDate(lastUpdated) : (english ? 'No posts yet' : '暂无文章')}</div>
        <div class="text-sm text-muted-foreground">{english ? 'Latest Update' : '最近更新'}</div>
      </div>
    </div>
    
    <div class="group flex flex-col items-center gap-2 rounded-lg border border-border bg-card p-4 shadow-xs transition-all hover:border-foreground/25 hover:shadow-lg">
      <Icon name="document" class="size-5 text-muted-foreground group-hover:text-primary transition-colors" />
      <div class="text-center">
        <div class="text-2xl font-bold text-foreground group-hover:text-primary transition-colors">{formatNumber(totalWords)}</div>
        <div class="text-sm text-muted-foreground">{english ? 'Total Words' : '文章字数'}</div>
      </div>
    </div>
  </div>
  
  <div class="flex items-center justify-between text-sm border-t border-border pt-3">
    <span class="text-muted-foreground">{english ? 'Total Posts' : '文章总数'}</span>
    <span class="font-medium text-foreground">{allPosts.length}</span>
  </div>
</div>

<script>
  import { watchSiteDays } from '../../lib/site-days'
  class SiteDays extends HTMLElement {
    private controller?: AbortController
    connectedCallback() {
      if (this.controller) return
      this.controller = new AbortController()
      watchSiteDays(this, this.controller.signal)
    }
    disconnectedCallback() { this.controller?.abort(); this.controller = undefined }
  }
  if (!customElements.get('site-days')) customElements.define('site-days', SiteDays)
</script>

<style>
  .group { min-width: 0; overflow-wrap: anywhere; }
</style>
