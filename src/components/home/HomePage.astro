---
import { Button, Card, Icon } from '@/components/user'
import ContributionSnake from './ContributionSnake.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from './Section.astro'
import BlogStats from './BlogStats.astro'
import JilinUniversityEmblem from '@/assets/brand/jilin-university.svg'
import config from '@/site-config'
import { profile } from '../../lib/cms-content'
import { profileAvatar } from '../../lib/content-image'
import { educationCards } from '../../lib/profile-education'
import { safeUrl } from '../../../supabase/functions/_shared/git-content'

const en = Astro.currentLocale === 'en'
const p = profile[en ? 'en' : 'zh']
const education = educationCards(p, profile.schoolUrl)
const jilinUniversityName = /^(?:吉林大学|吉大|Jilin University|JLU)(?:\s*(?:·\s*JLU|[(（]JLU[)）]))?$/i
const socialLinks = ([
  { icon: 'github-mark', label: 'GitHub', href: profile.github ? `https://github.com/${profile.github}` : '' },
  { icon: 'acwing', label: 'AcWing', href: profile.acwingUrl },
  { icon: 'zhihu', label: en ? 'Zhihu' : '知乎', href: profile.zhihuUrl },
  { icon: 'email', label: en ? 'Email' : '邮箱', href: profile.email ? `mailto:${profile.email}` : '' }
] as const).filter(({ icon, href }) => icon === 'email' ? Boolean(href) : safeUrl(href))
---

<PageLayout meta={{ title: en ? 'Home' : '首页' }} highlightColor='#659EB966'>
  <main class='home-layout'>
    <section class='home-profile animate' id='content-header'>
      <div class='profile-heading'>
        <img src={profileAvatar(profile.avatar)} alt={p.name} class='profile-avatar shrink-0 rounded-lg border p-1' width='176' height='176' loading='eager' />
        <div class='profile-details flex min-w-0 flex-col gap-y-4'>
          <h1 class='text-3xl font-bold'>{p.homeName}</h1>
          {socialLinks.length > 0 && (
            <div class='profile-links'>
              {socialLinks.map(({ icon, label, href }) => {
                const external = icon !== 'email'
                return (
                  <a class='profile-link' {href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}
                    aria-label={label} title={label}>
                    <Icon name={icon} />
                  </a>
                )
              })}
            </div>
          )}
        </div>
      </div>
    </section>

    <div id='content' class='home-content animate'>
      <Section title={en ? 'About' : '关于我'} class='home-section'>
        <p class='font-medium'>
          {p.role}{' '}
          {p.spoiler && <button class='role-spoiler' type='button' aria-expanded='false' aria-label={en ? 'Reveal playful introduction' : '显示趣味介绍'}
            data-role-spoiler data-reveal-hint={en ? 'Tap to reveal' : '轻点查看'}>
            <span>{p.spoiler}</span>
          </button>}
        </p>
        <p class='home-intro text-muted-foreground'>
          {p.intro}
        </p>
        <Button title={en ? 'More about me' : '更多关于我'} class='w-fit self-end' href={en ? '/en/about' : '/about'} style='ahead' />
      </Section>
      {education.length > 0 && <Section title={en ? 'Education' : '教育背景'} class='home-section'>
        {education.map(item => {
          const showEmblem = jilinUniversityName.test(item.school)
          return (
            <Card as={item.href ? 'a' : 'div'} href={item.href || undefined}
              target={item.href ? '_blank' : undefined} rel={item.href ? 'noopener noreferrer' : undefined}
              class:list={['home-card-feedback', showEmblem && 'education-card-jlu']}
              heading={item.school} subheading={item.major} date={item.period}>
              {showEmblem && <span slot='decoration' class='education-emblem' aria-hidden='true'>
                <JilinUniversityEmblem />
              </span>}
            </Card>
          )
        })}
      </Section>}
      <Section title={en ? 'Statistics' : '站点统计'} class='home-section'>
        <BlogStats blogStartDate={new Date(config.personal?.blogStartDate || '2026-10-18')} />
      </Section>
      <ContributionSnake />
    </div>
  </main>
</PageLayout>

<style>
  /* Layout belongs here, without competing utility declarations at the same specificity. */
  .home-layout { display:flex; width:100%; flex-direction:column; align-items:center; }
  .home-profile { display:flex; flex-direction:column; align-items:center; margin-bottom:2.5rem; }
  .profile-heading { display:flex; flex-direction:row; align-items:center; gap:1.5rem; }
  .profile-avatar { width:7rem; height:7rem; object-fit:cover; }
  .profile-links { display:flex; flex-wrap:wrap; gap:.25rem; margin-inline-start:-.625rem; }
  .profile-link {
    display:grid;
    place-items:center;
    width:2.75rem;
    height:2.75rem;
    border-radius:.375rem;
    color:hsl(var(--muted-foreground));
    transition:color .3s ease;
  }
  .profile-link > :global(svg) { width:1.5rem; height:1.5rem; transition:transform .3s ease, filter .3s ease; }
  .profile-link:focus-visible { color:hsl(var(--primary)); outline:2px solid currentColor; outline-offset:2px; }
  .profile-link:active { color:hsl(var(--primary)); }
  .profile-link:active > :global(svg) { transform:translateY(-2px); }
  @media (hover:hover) {
    .profile-link:hover { color:hsl(var(--primary)); }
    .profile-link:hover > :global(svg) {
      transform:translateY(-2px);
      filter:drop-shadow(0 .15rem .2rem hsl(var(--primary) / .3));
    }
  }
  .home-content { display:flex; width:100%; min-width:0; flex-direction:column; gap:2.5rem; }
  .home-content :global(.education-card-jlu) {
    --education-emblem-size:clamp(3.75rem, 16vw, 4.5rem);
    --education-emblem-inset:clamp(.75rem, 4vw, 1.5rem);
    padding-inline-end:calc(var(--education-emblem-size) + var(--education-emblem-inset) + clamp(.625rem, 2.6vw, .75rem));
  }
  .education-emblem {
    position:absolute;
    inset-block-start:50%;
    inset-inline-end:var(--education-emblem-inset);
    inline-size:var(--education-emblem-size);
    aspect-ratio:1;
    transform:translateY(-50%);
    color:hsl(var(--primary));
    opacity:.52;
    pointer-events:none;
  }
  .education-emblem > :global(svg) { display:block; inline-size:100%; block-size:100%; }
  .home-intro { line-height:1.9; text-align:justify; text-align-last:start; text-wrap:pretty; }
  .home-intro:lang(en) { text-align:start; }
  .role-spoiler { position:relative; display:inline-block; border-radius:.3rem; background:hsl(var(--muted)); padding:.08em .35em; cursor:pointer; vertical-align:baseline; touch-action:manipulation; }
  .role-spoiler span { opacity:0; transition:opacity .18s ease; }
  .role-spoiler[aria-expanded='true'] span, .role-spoiler:focus-visible span { opacity:1; }
  .role-spoiler:focus-visible { outline:2px solid hsl(var(--foreground)); outline-offset:3px; }
  @media (hover:hover) { .role-spoiler:hover span { opacity:1; } }
  @media (hover:none) {
    .role-spoiler { min-inline-size:4.5rem; }
    .role-spoiler[aria-expanded='false'] span { opacity:0; }
    .role-spoiler[aria-expanded='false']::after {
      content:attr(data-reveal-hint); position:absolute; inset:0; display:grid; place-items:center;
      color:hsl(var(--muted-foreground)); font-size:.75rem; white-space:nowrap;
    }
  }
  @media (prefers-reduced-motion:reduce) {
    .role-spoiler span, .profile-link, .profile-link > :global(svg) { transition:none; }
    .profile-link:is(:hover,:active) > :global(svg) { transform:none; }
  }
  @media (max-width:767px) {
    .home-profile { align-self:flex-start; }
    .profile-links { column-gap:.125rem; }
  }
  @media (max-width:359px) {
    .profile-heading { gap:.75rem; }
    .profile-avatar { width:5.5rem; height:5.5rem; }
  }
  @media (min-width:640px) { .profile-avatar { width:9rem; height:9rem; } }
  @media (min-width:768px) and (max-width:1023px) { .home-content { width:80%; } }
  @media (min-width:1024px) {
    .home-layout { display:grid; grid-template-columns:15rem minmax(0,1fr); align-items:start; gap:3rem; padding-block:1rem; }
    .home-profile { position:sticky; top:7rem; margin-bottom:0; align-items:flex-start; min-width:0; }
    .profile-heading { flex-direction:column; align-items:flex-start; gap:1.75rem; }
    .profile-avatar { width:11rem; height:11rem; object-fit:cover; }
    .profile-details h1 { letter-spacing:-.035em; }
    .home-content :global(.home-section) { flex-direction:column; gap:1rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-role-spoiler]').forEach((button) => {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true'
      button.setAttribute('aria-expanded', String(expanded))
      button.setAttribute('aria-label', expanded
        ? button.textContent?.trim() || ''
        : document.documentElement.lang === 'en' ? 'Reveal playful introduction' : '显示趣味介绍')
    })
  })
</script>
