---
import { contributionWeeks, fetchContributions } from '../../lib/github-contributions'

interface Props { username: string }
const { username } = Astro.props
const english = Astro.currentLocale === 'en'
const githubURL = `https://github.com/${encodeURIComponent(username)}`
const data = await fetchContributions(username)
const days = data?.contributions ?? []
const weeks = contributionWeeks(days)
const startDate = days[0]?.date
const endDate = days.at(-1)?.date
const monthNames = english
  ? ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
  : ['1月', '2月', '3月', '4月', '5月', '6月', '7月', '8月', '9月', '10月', '11月', '12月']
const monthLabels: { column: number; label: string }[] = []
let previousMonth = ''
weeks.forEach((week, column) => {
  const date = week.find(Boolean)?.date
  if (!date) return
  const month = date.slice(0, 7)
  if (month !== previousMonth) {
    // A partial final month needs room for its label.
    if (column < weeks.length - 2) monthLabels.push({ column, label: monthNames[Number(date.slice(5, 7)) - 1] })
    previousMonth = month
  }
})
const size = 10
const pitch = 13
const labelWidth = 31
const labelHeight = 20
const width = labelWidth + weeks.length * pitch - (pitch - size)
const height = labelHeight + 7 * pitch - (pitch - size)
const titleId = `github-calendar-${username.toLowerCase()}`
const dateLabel = (date: string, count: number) => english
  ? `${count === 0 ? 'No' : count} contribution${count === 1 ? '' : 's'} on ${date}`
  : `${date}：${count} 次贡献`
const colors = [
  'fill-[#eff2f5] dark:fill-[#151b23]',
  'fill-[#aceebb] dark:fill-[#033a16]',
  'fill-[#4ac26b] dark:fill-[#196c2e]',
  'fill-[#2da44e] dark:fill-[#2ea043]',
  'fill-[#116329] dark:fill-[#56d364]'
]
---

<section class='min-w-0 w-full max-w-full' aria-labelledby={titleId}>
  <div class='mb-3 flex flex-wrap items-baseline justify-between gap-2'>
    <h2 id={titleId} class='text-base font-medium'>
      {data
        ? (english ? `${data.total} contributions in the last year` : `过去一年共 ${data.total} 次贡献`)
        : (english ? 'GitHub contributions' : 'GitHub 贡献记录')}
    </h2>
    <a href={githubURL} target='_blank' rel='noopener noreferrer' class='text-xs text-muted-foreground underline-offset-4 hover:text-foreground hover:underline'>GitHub ↗</a>
  </div>
  {data ? (
    <github-calendar class='block rounded-md border border-border px-3 py-4 sm:px-4'>
      <p class='sr-only' id={`${titleId}-help`}>
        {english ? 'Select a day for its contribution count. Use arrow keys to move between days, or Home and End to jump to the start and end.' : '选择日期查看贡献次数；可用方向键逐日或逐周移动，Home 和 End 跳到起止日期。'}
      </p>
      <div class='calendar-scroll min-w-0 max-w-full overflow-x-auto pb-2' data-calendar-scroll>
        <svg class='block max-w-none text-muted-foreground' width={width} height={height} viewBox={`0 0 ${width} ${height}`} role='group' aria-label={english ? 'Daily GitHub contributions' : '每日 GitHub 贡献'} aria-describedby={`${titleId}-help`}>
          <g font-size='10' fill='currentColor' aria-hidden='true'>
            {monthLabels.map(({ column, label }) => <text x={labelWidth + column * pitch} y={10}>{label}</text>)}
            {[1, 3, 5].map((day, index) => <text x={0} y={labelHeight + day * pitch + size - 1}>{english ? ['Mon', 'Wed', 'Fri'][index] : ['一', '三', '五'][index]}</text>)}
          </g>
          {weeks.map((week, column) => week.map((day, row) => day ? (
            <rect
              class:list={['calendar-day', colors[day.level]]}
              x={labelWidth + column * pitch} y={labelHeight + row * pitch}
              width={size} height={size} rx='2'
              role='button' tabindex={day.date === endDate ? 0 : -1}
              aria-label={dateLabel(day.date, day.count)}
              data-calendar-day data-date={day.date} data-level={day.level}
            ><title>{dateLabel(day.date, day.count)}</title></rect>
          ) : null))}
        </svg>
      </div>
      <div class='mt-2 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 text-xs text-muted-foreground'>
        <output class='min-w-0' data-day-detail aria-live='polite'>{startDate} – {endDate}</output>
        <div class='flex shrink-0 items-center gap-1' aria-hidden='true'>
          <span class='mr-1'>{english ? 'Less' : '少'}</span>
          {colors.map((color) => <svg width={size} height={size}><rect width={size} height={size} rx='2' class={color} /></svg>)}
          <span class='ml-1'>{english ? 'More' : '多'}</span>
        </div>
      </div>
    </github-calendar>
  ) : (
    <p class='rounded-md border border-border px-4 py-5 text-sm text-muted-foreground'>
      {english ? 'Contribution history is temporarily unavailable. ' : '贡献记录暂不可用，'}
      <a href={githubURL} target='_blank' rel='noopener noreferrer' class='underline underline-offset-4 hover:text-foreground'>{english ? 'View on GitHub' : '前往 GitHub 查看'}</a>
    </p>
  )}
</section>

<style>
  .calendar-day { cursor: pointer; stroke: hsl(var(--foreground) / .05); stroke-width: 1px; }
  .calendar-day:hover, .calendar-day:focus-visible { stroke: hsl(var(--foreground)); stroke-width: 1.5px; outline: none; }
  .calendar-scroll { scrollbar-width: thin; scrollbar-color: hsl(var(--muted-foreground) / .4) transparent; }
</style>

<script>
  class GitHubCalendar extends HTMLElement {
    private listeners?: AbortController
    connectedCallback() {
      this.listeners?.abort()
      this.listeners = new AbortController()
      const options = { signal: this.listeners.signal }
      const days = [...this.querySelectorAll<SVGRectElement>('[data-calendar-day]')]
      const detail = this.querySelector<HTMLOutputElement>('[data-day-detail]')
      const scroller = this.querySelector<HTMLElement>('[data-calendar-scroll]')
      if (!days.length || !detail) return
      const select = (day: SVGRectElement, focus = false) => {
        for (const item of days) item.setAttribute('tabindex', item === day ? '0' : '-1')
        detail.textContent = day.getAttribute('aria-label')
        if (focus) {
          day.focus({ preventScroll: true })
          day.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' })
        }
      }
      const getDay = (event: Event) => event.target instanceof Element
        ? event.target.closest<SVGRectElement>('[data-calendar-day]') : null
      this.addEventListener('focusin', event => { const day = getDay(event); if (day) select(day) }, options)
      this.addEventListener('click', event => { const day = getDay(event); if (day) select(day) }, options)
      this.addEventListener('pointerover', event => {
        const day = getDay(event)
        if (day) detail.textContent = day.getAttribute('aria-label')
      }, options)
      this.addEventListener('keydown', event => {
        const day = getDay(event)
        if (!day) return
        const index = days.indexOf(day)
        const offsets: Record<string, number> = { ArrowLeft: -7, ArrowRight: 7, ArrowUp: -1, ArrowDown: 1 }
        let next: number
        if (event.key in offsets) next = Math.max(0, Math.min(days.length - 1, index + offsets[event.key]))
        else if (event.key === 'Home') next = 0
        else if (event.key === 'End') next = days.length - 1
        else if (event.key === 'Enter' || event.key === ' ') next = index
        else return
        event.preventDefault()
        select(days[next], true)
      }, options)
      // Keep recent activity visible when the year needs horizontal scrolling.
      if (scroller) scroller.scrollLeft = scroller.scrollWidth
    }
    disconnectedCallback() { this.listeners?.abort() }
  }
  if (!customElements.get('github-calendar')) customElements.define('github-calendar', GitHubCalendar)
</script>
