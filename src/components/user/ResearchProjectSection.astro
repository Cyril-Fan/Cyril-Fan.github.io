---
import {renderProjects} from '../../lib/page-presentation'
import {contentImage} from '../../lib/content-image'
import '../../assets/styles/page-presentation.css'
const {projects,class:className}=Astro.props
---
<div class={className} set:html={renderProjects(projects.map((p:Record<string,any>)=>({...p,image:contentImage(p.image,'src/assets/projects/index.md')})),Astro.currentLocale==='en')} />
