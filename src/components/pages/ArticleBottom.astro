---
import { renderArticleNeighbors } from '../../lib/page-presentation'
import '../../assets/styles/page-presentation.css'
const {id,collections,class:className}=Astro.props
const en=Astro.currentLocale==='en',category=collections.find((p:any)=>p.id===id)?.data.category
const peers=category?collections.filter((p:any)=>p.data.category===category):collections
const index=peers.findIndex((p:any)=>p.id===id)
const items=index<0?[]:[{post:peers[index-1],direction:'prev'},{post:peers[index+1],direction:'next'}].filter(x=>x.post).map(x=>({title:x.post.data.title,href:(en?'/en':'')+'/blog/'+x.post.id,direction:x.direction}))
---
<nav class:list={['article-neighbors',className]} aria-label={en?'Adjacent articles':'相邻文章'} set:html={renderArticleNeighbors(items,en)} />
