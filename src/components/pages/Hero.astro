---
import { renderArticleHeader } from '../../lib/page-presentation'
import { contentImage } from '../../lib/content-image'
import '../../assets/styles/page-presentation.css'
const {data,filePath,remarkPluginFrontmatter={},fallback=false}=Astro.props
const html=renderArticleHeader(data,{en:Astro.currentLocale==='en',minutes:String(remarkPluginFrontmatter.minutesRead||''),image:contentImage(data.heroImage?.src,filePath),fallback})
---
<Fragment set:html={html} />
