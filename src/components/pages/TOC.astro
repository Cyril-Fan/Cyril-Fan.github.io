---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '@/plugins/toc'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}

const { headings, class: className, ...props } = Astro.props

const toc = generateToc(headings)
---

<toc-heading class={className} role='navigation' aria-label={Astro.currentLocale === 'en' ? 'Table of contents' : '文章目录'} {...props}>
  <h2 class='font-semibold'>{Astro.currentLocale === 'en' ? 'CONTENTS' : '目录'}</h2>
  <ul class='mt-4 text-card-foreground'>
    {toc.map((heading) => <TOCHeading heading={heading} />)}
  </ul>
</toc-heading>

<style>
  toc-heading { display:block; }
</style>

<script>
  interface TOCLink {
    element: HTMLAnchorElement
    progressBar: HTMLElement | null
    slug: string
  }

  interface HeadingProgress {
    inView: boolean
    progress: number
  }

  class TOC extends HTMLElement {
    headings: HTMLElement[] = []
    tocLinks: TOCLink[] = []
    headingProgress: Record<string, HeadingProgress> = {}
    private contentElement: HTMLElement | null = null
    private eventController?: AbortController
    private resizeObserver?: ResizeObserver
    private animationFrame: number | null = null

    private requestUpdate = () => {
      if (this.animationFrame !== null) return
      this.animationFrame = window.requestAnimationFrame(() => {
        this.animationFrame = null
        if (this.isConnected) this.updatePositionAndStyle()
      })
    }

    updatePositionAndStyle = () => {
      if (!this.contentElement) return
      const windowHeight = window.innerHeight
      const contentBottom = this.contentElement.getBoundingClientRect().bottom
      this.headingProgress = {}

      this.headings.forEach((el, index) => {
        const headingRect = el.getBoundingClientRect()
        const sectionStart = headingRect.top
        const sectionEnd = this.headings[index + 1]?.getBoundingClientRect().top ?? contentBottom
        // A collapsed or empty section still has finite progress.
        const titleHeight = /^H[2-6]$/.test(el.tagName) ? headingRect.height : 0
        const sectionHeight = Math.max(1, sectionEnd - sectionStart - titleHeight)
        const progress = (windowHeight - sectionStart) / sectionHeight

        this.headingProgress[el.id] = {
          inView: sectionStart < windowHeight && sectionEnd > 0,
          progress: Math.max(0, Math.min(1, progress))
        }
      })

      const currentSlug = this.headings.find((heading) => this.headingProgress[heading.id]?.inView)?.id
      this.tocLinks.forEach(({ element: el, progressBar: bar, slug }, i) => {
        const { inView, progress } = this.headingProgress[slug] ?? { inView: false, progress: 0 }
        const previousSlug = this.tocLinks[i - 1]?.slug
        const nextSlug = this.tocLinks[i + 1]?.slug
        el.classList.toggle('highlight', inView)
        el.classList.toggle('highlight-bg-translucent', inView)
        el.classList.toggle('rounded-t-2xl', inView && !(previousSlug && this.headingProgress[previousSlug]?.inView))
        el.classList.toggle('rounded-b-2xl', inView && !(nextSlug && this.headingProgress[nextSlug]?.inView))
        if (slug === currentSlug) el.setAttribute('aria-current', 'location')
        else el.removeAttribute('aria-current')
        if (bar) {
          bar.classList.toggle('readed', !inView && progress === 1)
          bar.classList.toggle('highlight-bg', inView)
          bar.style.setProperty('height', `${progress * 90}%`)
        }
      })
    }

    connectedCallback() {
      this.disconnectedCallback()
      this.eventController = new AbortController()
      const { signal } = this.eventController
      this.contentElement = document.getElementById('content')
      this.tocLinks = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')).map((link) => {
        const fragment = (link.getAttribute('href') || '').slice(1)
        let slug = fragment
        try { slug = decodeURIComponent(fragment) } catch { /* Keep malformed fragments harmless. */ }
        return {
          element: link,
          progressBar: link.parentElement?.querySelector<HTMLElement>('[data-toc-progress]') ?? null,
          slug
        }
      })

      // Only configured anchors enter the TOC. Markdown headings inside user
      // comments must never become navigation entries or section boundaries.
      if (this.tocLinks.some(link => link.slug === 'comments')) {
        this.contentElement = this.contentElement?.closest<HTMLElement>('[data-toc-content]') ?? this.contentElement
      }
      this.headings = this.tocLinks.map(link => document.getElementById(link.slug))
        .filter((element): element is HTMLElement => Boolean(element && this.contentElement?.contains(element)))

      this.tocLinks.forEach((link) => {
        link.element.addEventListener('click', (e) => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
          const directHeading = this.headings.find((heading) => heading.id === link.slug)
          if (!directHeading) return
          e.preventDefault()
          const fragment = link.element.getAttribute('href') || ''
          if (window.location.hash !== fragment) history.pushState(null, '', fragment)
          directHeading.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
          })
          this.requestUpdate()
        }, { signal })
      })

      window.addEventListener('scroll', this.requestUpdate, { passive: true, signal })
      window.addEventListener('resize', this.requestUpdate, { passive: true, signal })
      window.addEventListener('load', this.requestUpdate, { once: true, signal })
      this.contentElement?.addEventListener('load', this.requestUpdate, { capture: true, signal })
      if (this.contentElement && typeof ResizeObserver !== 'undefined') {
        this.resizeObserver = new ResizeObserver(this.requestUpdate)
        this.resizeObserver.observe(this.contentElement)
      }
      this.updatePositionAndStyle()
    }

    disconnectedCallback() {
      this.eventController?.abort()
      this.eventController = undefined
      this.resizeObserver?.disconnect()
      this.resizeObserver = undefined
      if (this.animationFrame !== null) window.cancelAnimationFrame(this.animationFrame)
      this.animationFrame = null
    }
  }

  if (!customElements.get('toc-heading')) customElements.define('toc-heading', TOC)
</script>
