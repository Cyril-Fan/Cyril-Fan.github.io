---
import '@pagefind/default-ui/css/ui.css'
---

<site-search>
  <aside class='form my-4'>
    {
      import.meta.env.DEV ? (
        <div class='w-full rounded-xl border-2 bg-transparent px-4 py-2 pe-3 outline-hidden focus:border-foreground'>
          {Astro.currentLocale === 'en' ? 'You are in Dev mode, the search is disabled.' : '开发模式下暂不提供搜索，请构建后通过预览验证。'}
        </div>
      ) : (
        <div id='site-search' />
      )
    }
  </aside>
</site-search>

<script>
  class SiteSearch extends HTMLElement {
    constructor() {
      super()

      // const shouldStrip = this.dataset.stripTrailingSlash !== undefined
      // const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2')
      // const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path
      const formatURL = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2')

      window.addEventListener('DOMContentLoaded', () => {
        if (import.meta.env.DEV || !this.querySelector('#site-search')) return
        const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1))
        onIdle(async () => {
          // @ts-expect-error — Missing types for @pagefind/default-ui package.
          const { PagefindUI } = await import('@pagefind/default-ui')
          new PagefindUI({
            element: '#site-search',
            baseUrl: import.meta.env.BASE_URL,
            bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
            showImages: false,
            showSubResults: true,
            translations: document.documentElement.lang.startsWith('zh') ? {
              placeholder: '搜索',
              clear_search: '清除',
              load_more: '加载更多结果',
              search_label: '站内搜索',
              filters_label: '筛选',
              zero_results: '未找到“[SEARCH_TERM]”的结果',
              many_results: '找到 [COUNT] 条与“[SEARCH_TERM]”相关的结果',
              one_result: '找到 [COUNT] 条与“[SEARCH_TERM]”相关的结果',
              total_zero_results: '暂无结果',
              total_one_result: '[COUNT] 条结果',
              total_many_results: '[COUNT] 条结果',
              searching: '正在搜索“[SEARCH_TERM]”…',
              results_label: '搜索结果'
            } : undefined,
            processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
              result.url = formatURL(result.url)
              result.sub_results = result.sub_results.map((sub_result) => {
                sub_result.url = formatURL(sub_result.url)
                return sub_result
              })
            }
          })
        })
      })
    }
  }
  customElements.define('site-search', SiteSearch)
</script>

<style>
  #site-search {
    --pagefind-ui-scale: 0.8;
    --pagefind-ui-primary: hsl(var(--primary) / var(--tw-bg-opacity, 1));
    --pagefind-ui-text: hsl(var(--foreground) / var(--tw-text-opacity, 1));
    --pagefind-ui-background: hsl(var(--muted) / var(--tw-bg-opacity, 1));
    --pagefind-ui-border: hsl(var(--border) / var(--tw-border-opacity, 1));
    --pagefind-ui-tag: hsl(var(--muted-foreground) / var(--tw-text-opacity, 1));
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: calc(var(--radius) + 2px);
    --pagefind-ui-image-border-radius: calc(var(--radius) + 2px);
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: sans-serif;
  }
</style>
