---
import { Icon } from '@/components/user'

const { header: headerName, content: contentName, end: endName, needPercent = true } = Astro.props
---

<button
  aria-label={Astro.currentLocale === 'en' ? 'Back to top' : '返回顶部'}
  class='z-90 group fixed bottom-8 end-4 flex h-10 w-10 translate-y-28 items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground opacity-0 transition-all duration-300 hover:border-border/75 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12'
  data-show='false'
  tabindex='-1'
  id='to-top-btn'
>
  <div
    class='absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center transition-opacity group-hover:opacity-0 group-[.ended]:opacity-0'
  >
    <span class='text'>0</span>
    <span class='text-xs'>%</span>
  </div>
  <Icon
    name='up'
    class='opacity-0 transition-opacity group-hover:opacity-100 group-[.ended]:opacity-100'
  />
</button>

<script is:inline define:vars={{ headerName, contentName, endName, needPercent }}>
(() => {
  const scrollBtn = document.getElementById('to-top-btn')
  const scrollPercentEl = scrollBtn?.querySelector('.text')
  const targetHeader = document.getElementById(headerName)
  const articleElement = document.getElementById(contentName)
  const endElement = endName ? document.getElementById(endName) : null
  if (!scrollBtn || !scrollPercentEl || !articleElement) return
  scrollBtn.addEventListener('click', () => {
    window.scrollTo({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', top: 0 })
  })
  if (targetHeader) {
    const observer = new IntersectionObserver(entries => {
      const visible = !entries[0].isIntersecting
      scrollBtn.dataset.show = String(visible)
      scrollBtn.tabIndex = visible ? 0 : -1
    })
    observer.observe(targetHeader)
  }
  if (!needPercent) {
    scrollBtn.classList.add('ended')
    return
  }
  // Measure the current viewport and document coordinates, including resized or
  // lazy-loaded content. A page may stop its reading range before a live feed.
  let frame = 0
  const update = () => {
    frame = 0
    const rect = articleElement.getBoundingClientRect()
    const top = rect.top + window.scrollY
    const end = (endElement?.getBoundingClientRect().top ?? rect.bottom) + window.scrollY
    const travel = end - top - window.innerHeight
    const percent = travel > 0 ? Math.round((window.scrollY - top) / travel * 100) : (window.scrollY + window.innerHeight >= end ? 100 : 0)
    const bounded = Math.max(0, Math.min(100, percent))
    scrollPercentEl.textContent = String(bounded)
    scrollBtn.classList.toggle('ended', bounded === 100)
  }
  const schedule = () => { if (!frame) frame = requestAnimationFrame(update) }
  document.addEventListener('scroll', schedule, { passive:true })
  window.addEventListener('resize', schedule)
  new ResizeObserver(schedule).observe(articleElement)
  update()
})()
</script>
