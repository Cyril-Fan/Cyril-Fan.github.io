---
import snapshot from '@/assets/friend-feeds.json'
import { createHash } from 'node:crypto'
import links from '@/public/links.json'
interface Article { title: string; link: string; date: string; source: string }
interface Feed { source: string; status: string; lastSuccessAt?: string | null; articles: Article[] }
const en = Astro.currentLocale === 'en'
const friends = links.friends.flatMap(group => group.link_list)
const feeds = snapshot.feeds as Feed[]
const articles = feeds.flatMap(feed => feed.articles).sort((a,b) => b.date.localeCompare(a.date) || a.link.localeCompare(b.link))
const sourceMap = new Map(friends.map(friend => [friend.link, friend]))
const readable = feeds.filter(feed => feed.status === 'ok').length
const stale = feeds.some(feed => feed.status === 'unavailable')
const lastUpdated = snapshot.checkedAt as string | null
const revision = createHash('sha256').update(JSON.stringify(feeds.map(feed => ({ source:feed.source, articles:feed.articles })))).digest('hex')
const updateTime = lastUpdated ? new Intl.DateTimeFormat(en ? 'en-GB' : 'zh-CN', { timeZone:'Asia/Shanghai', year:'numeric', month:'2-digit', day:'2-digit', hour:'2-digit', minute:'2-digit', hourCycle:'h23' }).format(new Date(lastUpdated)) : null
---
<friend-feed class='not-prose' data-lang={en ? 'en' : 'zh'} data-revision={revision} data-checked={lastUpdated}>
  {articles.length > 0 ? <>
    <section class='random-card' data-random-panel hidden aria-label={en ? 'Random read' : '随机阅读'}>
      <span class='feed-eyebrow'>{en ? 'Random read' : '随便读读'}</span>
      <a data-random-title target='_blank' rel='noopener noreferrer'></a>
      <span class='feed-meta' data-random-meta></span>
      <button type='button' data-random-refresh>{en ? 'Try another' : '换一篇'} ↻</button>
    </section>
    <div class='feed-toolbar'><label>{en?'From':'来自'} <select data-feed-filter aria-label={en?'Filter by author':'按作者筛选'}><option value=''>{en?'All friends':'所有朋友'}</option>{friends.map(friend=><option value={friend.link}>{friend.name}</option>)}</select></label><span class='feed-meta'>{en?'Newest first':'按发布时间倒序'}</span></div>
    <div class='feed-articles' role='list' aria-label={en?'Recent posts':'近期文章'}>
      {articles.map(article => {
        const friend = sourceMap.get(article.source)
        return friend && <article class='feed-article' role='listitem' data-feed-article data-source={friend.link}>
          <button class='feed-author' type='button' data-author={friend.link} data-name={friend.name} aria-label={en ? `Recent posts by ${friend.name}` : `查看 ${friend.name} 的近期文章`}>
            <img class='no-lightbox' src={friend.avatar} width='40' height='40' alt='' loading='lazy' />
            <span>{friend.name}</span>
          </button>
          <a class='feed-title' href={article.link} target='_blank' rel='noopener noreferrer'>{article.title}</a>
          <time datetime={article.date}>{article.date.slice(0,10)}</time>
        </article>
      })}
    </div>
    <button class='feed-more' type='button' data-load-more hidden>{en ? 'Load more' : '加载更多'}</button>
    <p data-feed-status class='feed-meta' role='status' aria-live='polite'></p>
  </> : <p class='feed-empty'>{en ? 'No recent posts are available yet. You can still explore the blogs above.' : '暂时没有可展示的文章，欢迎先逛逛上面的博客。'}</p>}
  <div class='feed-summary'>
    <span data-feed-update hidden role='status'>{en ? 'New reading-feed content is available. ' : '朋友圈有更新。'}<a target='_blank' rel='noopener noreferrer'>{en ? 'Open the latest feed in a new tab ↗' : '在新标签页查看最新版 ↗'}</a></span>
    <span>{en ? `${friends.length} blogs · ${readable} feeds available · ${articles.length} recent posts` : `${friends.length} 位朋友 · ${readable} 个订阅可用 · ${articles.length} 篇近期文章`}</span>
    {updateTime && <span>{en ? 'Last checked: ' : '上次检查：'}<time datetime={lastUpdated!}>{updateTime}</time> (UTC+8)</span>}
    {stale && <span>{en ? 'Some feeds are temporarily unavailable; saved posts remain available.' : '部分订阅暂时无法更新，已保留上次可用的文章。'}</span>}
  </div>
  <dialog class='author-dialog' aria-labelledby='feed-author-title'>
    <div class='author-dialog-header'><h3 id='feed-author-title'></h3><button type='button' data-close-author aria-label={en ? 'Close recent posts' : '关闭近期文章'}>×</button></div>
    <a data-author-site target='_blank' rel='noopener noreferrer'>{en ? 'Visit this blog' : '访问博客'} ↗</a>
    <ul data-author-articles></ul>
  </dialog>
</friend-feed>
<script>
  import { watchFriendFeed } from '../../lib/friend-feed-refresh'
  class FriendFeed extends HTMLElement {
    private controller?: AbortController
    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      watchFriendFeed(this, signal)
      const en = this.dataset.lang === 'en'
      const cards = [...this.querySelectorAll<HTMLElement>('[data-feed-article]')]
      const dialog = this.querySelector<HTMLDialogElement>('dialog')!
      const more = this.querySelector<HTMLButtonElement>('[data-load-more]')
      const status = this.querySelector<HTMLElement>('[data-feed-status]')
      let count = 12
      const filter=this.querySelector<HTMLSelectElement>('[data-feed-filter]')
      let lastRandom = -1
      let opener: HTMLElement | null = null
      const paginate = () => {
        const matching=cards.filter(card=>!filter?.value||card.dataset.source===filter.value)
        cards.forEach(card => card.hidden = !matching.slice(0,count).includes(card))
        if (more) more.hidden = matching.length <= count
        if (status) status.textContent = en ? `Showing ${Math.min(count,matching.length)} of ${matching.length} posts.` : `已显示 ${Math.min(count,matching.length)} / ${matching.length} 篇文章。`
      }
      filter?.addEventListener('change',()=>{count=12;paginate()},{signal})
      const random = () => {
        if (!cards.length) return
        let index = Math.floor(Math.random() * (cards.length - (lastRandom >= 0 && cards.length > 1 ? 1 : 0)))
        if (cards.length > 1 && lastRandom >= 0 && index >= lastRandom) index++
        lastRandom = index
        const card = cards[index]
        const source = card.querySelector<HTMLAnchorElement>('.feed-title')!
        const target = this.querySelector<HTMLAnchorElement>('[data-random-title]')!
        target.href = source.href
        target.textContent = source.textContent
        this.querySelector<HTMLElement>('[data-random-meta]')!.textContent = `${card.querySelector('[data-name]')?.getAttribute('data-name')} · ${card.querySelector('time')?.textContent}`
        this.querySelector<HTMLElement>('[data-random-panel]')!.hidden = false
      }
      this.addEventListener('click', event => {
        const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('button') : null
        if (button?.hasAttribute('data-load-more')) { count += 12; paginate() }
        if (button?.hasAttribute('data-random-refresh')) random()
        if (button?.hasAttribute('data-close-author')) dialog.close()
        if (event.target === dialog) {
          const rect = dialog.getBoundingClientRect()
          if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close()
        }
        if (!button?.dataset.author) return
        opener = button
        const author = button.dataset.author
        this.querySelector('#feed-author-title')!.textContent = en ? `Recent posts · ${button.dataset.name}` : `${button.dataset.name} · 近期文章`
        this.querySelector<HTMLAnchorElement>('[data-author-site]')!.href = author
        const list = this.querySelector('[data-author-articles]')!
        list.replaceChildren()
        for (const card of cards.filter(card => card.dataset.source === author)) {
          const item = document.createElement('li')
          item.append(card.querySelector('.feed-title')!.cloneNode(true), card.querySelector('time')!.cloneNode(true))
          list.append(item)
        }
        dialog.showModal()
      }, { signal })
      dialog.addEventListener('close', () => opener?.focus(), { signal })
      paginate()
      random()
    }
    disconnectedCallback() { this.controller?.abort() }
  }
  if (!customElements.get('friend-feed')) customElements.define('friend-feed', FriendFeed)
</script>
<style>
  friend-feed { display:block; }
  [hidden] { display:none!important; }
  .random-card { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:.4rem 1rem; padding:1.2rem; border:1px solid hsl(var(--border)); border-radius:1rem; background:hsl(var(--muted)/.4); margin-bottom:1.25rem; }
  .feed-eyebrow { font-size:.75rem; color:hsl(var(--primary)); }
  [data-random-title] { grid-column:1; overflow-wrap:anywhere; font-weight:600; }
  .random-card button { grid-column:2; grid-row:1/4; align-self:center; }
  .feed-meta, time { font-size:.8rem; color:hsl(var(--muted-foreground)); }
  .feed-toolbar { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.3rem 0 .8rem; }
  .feed-toolbar label { display:flex; align-items:center; gap:.5rem; font-size:.8rem; color:hsl(var(--muted-foreground)); }
  .feed-toolbar select { max-width:12rem; padding:.45rem .6rem; border:1px solid hsl(var(--border)); border-radius:.4rem; background:hsl(var(--background)); color:hsl(var(--foreground)); font:inherit; }
  .feed-articles { display:flex; flex-direction:column; border-top:1px solid hsl(var(--border)); }
  .feed-article { min-width:0; display:grid; grid-template-columns:7.5rem minmax(0,1fr) 5.3rem; align-items:center; gap:1rem; padding:1rem .4rem; border-bottom:1px solid hsl(var(--border)); transition:background-color .18s; }
  .feed-article:hover,.feed-article:focus-within { background:hsl(var(--muted)/.35); }
  .feed-author { display:flex; align-items:center; gap:.5rem; text-align:start; font-size:.78rem; color:hsl(var(--muted-foreground)); min-height:2.75rem; overflow-wrap:anywhere; }
  .feed-author img { border-radius:50%; width:1.8rem; height:1.8rem; object-fit:cover; flex-shrink:0; }
  .feed-title { overflow-wrap:anywhere; line-height:1.6; font-size:.9rem; }
  .feed-article time { text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums; font-size:.7rem; }
  button { transition:color .2s, background-color .2s; }
  button:hover, a:hover { color:hsl(var(--primary)); }
  :is(button,a):focus-visible { outline:2px solid hsl(var(--primary)); outline-offset:3px; border-radius:.3rem; }
  .feed-more, .random-card>button { border:1px solid hsl(var(--border)); border-radius:.5rem; padding:.55rem .8rem; min-height:2.75rem; }
  .feed-more { display:block; margin:1.25rem auto .6rem; }
  [data-feed-status] { text-align:center; margin-top:.75rem; }
  .feed-summary { display:flex; flex-wrap:wrap; justify-content:center; gap:.3rem 1rem; margin:1.25rem 0; font-size:.75rem; color:hsl(var(--muted-foreground)); }
  .author-dialog { padding:1.25rem; width:min(36rem,calc(100vw - 2rem)); max-height:80dvh; border:1px solid hsl(var(--border)); border-radius:1rem; background:hsl(var(--background)); color:hsl(var(--foreground)); }
  .author-dialog::backdrop { background:rgb(0 0 0/.45); backdrop-filter:blur(3px); }
  .author-dialog-header { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .author-dialog h3 { font-weight:600; }
  .author-dialog button { font-size:1.5rem; min-width:2.75rem; min-height:2.75rem; }
  .author-dialog a { color:hsl(var(--primary)); }
  [data-author-articles] { padding:0; margin-top:1rem; }
  :global([data-author-articles] li) { display:flex; flex-direction:column; gap:.3rem; padding:.8rem 0; border-top:1px solid hsl(var(--border)); }
  @media(max-width:640px) { .feed-article { grid-template-columns:minmax(0,1fr) auto; gap:.3rem .75rem; padding:.75rem .2rem 1rem; } .feed-title { grid-column:1/-1; grid-row:2; } .feed-article time { grid-column:2; grid-row:1; } .random-card { column-gap:.5rem; padding:1rem; } .feed-toolbar>.feed-meta { font-size:.7rem; } }
  @media(prefers-reduced-motion:reduce){.feed-article { transition:none; }}
</style>
