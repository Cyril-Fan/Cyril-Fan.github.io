---
import PageLayout from '@/layouts/CommonPage.astro'
import { academic } from '../../lib/cms-content'
import {renderAcademic,academicHeadings} from '../../lib/page-presentation'
import {contentImage} from '../../lib/content-image'
import '../../assets/styles/page-presentation.css'
import ArticleBody from './ArticleBody.astro'
const en=Astro.currentLocale==='en',p=structuredClone(academic[en?'en':'zh'])
for(const item of [...p.publications,...p.projects])if(item.image)item.image=contentImage(item.image,'src/assets/projects/index.md')
---
<PageLayout title={en?'Academic':'学术'} headings={academicHeadings(en)}>
  <ArticleBody html={renderAcademic(p,en)} />
</PageLayout>
