---
import PageLayout from '@/layouts/CommonPage.astro'
import { Icon, Button } from '@/components/user'
import Markdown from './Markdown.astro'
import PublicationSection from '../user/PublicationSection.astro'
import ResearchProjectSection from '../user/ResearchProjectSection.astro'
import { academic } from '../../lib/cms-content'
import type { iconsType } from '@/types'
const en=Astro.currentLocale==='en', p=academic[en?'en':'zh']
const headings=[
  {depth:2,slug:'about-me',text:en?'About Me':'学术背景'},
  {depth:2,slug:'research-interests',text:en?'Research Interests':'研究兴趣'},
  {depth:2,slug:'publications',text:en?'Publications':'论文'},
  {depth:2,slug:'open-source-projects',text:en?'Open-source Projects':'开源项目'}]
---
<PageLayout title={en?'Academic':'学术'} {headings}>
  <h2 id='about-me'>{headings[0].text}<a class='anchor' href='#about-me'>#</a></h2>
  <Markdown source={p.background} />
  {p.cv&&<Button title={en?'Curriculum Vitae':'简历'} href={p.cv} target='_blank' rel='noopener noreferrer' class='w-fit'/>}
  <h2 id='research-interests'>{headings[1].text}<a class='anchor' href='#research-interests'>#</a></h2>
  <div class='interest-grid not-prose'>
    {p.interests.map((interest:any)=><div class='interest-card group rounded-xl border border-border bg-card transition-colors hover:border-foreground/25'>
      <div class='interest-content'><div class='interest-icon rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'><Icon class='size-4 text-primary' name={(interest.icon||'cpu') as iconsType} /></div>
      <div class='interest-text'><p class='interest-title text-foreground'>{interest.title}</p>{interest.description&&<p class='interest-description text-muted-foreground'>{interest.description}</p>}</div></div>
    </div>)}
  </div>
  <h2 id='publications'>{headings[2].text}<a class='anchor' href='#publications'>#</a></h2>
  {p.publications.length ? <PublicationSection class='not-prose' publications={p.publications} groupByYear={false}/> : <p class='text-muted-foreground'>{en?'No publications to display yet.':'暂无公开展示的论文。'}</p>}
  <h2 id='open-source-projects'>{headings[3].text}<a class='anchor' href='#open-source-projects'>#</a></h2>
  {p.projects.length ? <ResearchProjectSection class='not-prose' projects={p.projects}/> : <p class='text-muted-foreground'>{en?'No projects to display yet.':'暂无公开展示的项目。'}</p>}
</PageLayout>
<style>
  .interest-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; }
  .interest-card { display:flex; align-items:center; padding:1rem .75rem; min-height:5.5rem; }
  .interest-content { display:flex; align-items:center; gap:.65rem; width:100%; min-width:0; }
  .interest-icon { display:flex; align-items:center; justify-content:center; width:2rem; height:2rem; flex-shrink:0; }
  .interest-text { flex:1; min-width:0; text-align:center; }
  .interest-title { margin:0; font-size:.9375rem; font-weight:500; line-height:1.45; text-wrap:balance; }
  .interest-title:lang(zh) { font-size:1.0625rem; }
  .interest-description { margin:.4rem 0 0; font-size:.8125rem; line-height:1.6; }
  @media(max-width:640px) { .interest-grid { grid-template-columns:1fr; }.interest-card { min-height:4.5rem; } }
</style>
