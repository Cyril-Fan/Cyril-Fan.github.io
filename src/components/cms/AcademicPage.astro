---
import PageLayout from '@/layouts/CommonPage.astro'
import { Icon } from '@/components/user'
import Markdown from './Markdown.astro'
import ProjectItems from './ProjectItems.astro'
import { academic, lines } from '../../lib/cms-content'
const en=Astro.currentLocale==='en', p=academic[en?'en':'zh']
const headings=[
  {depth:2,slug:'about-me',text:en?'About Me':'学术背景'},
  {depth:2,slug:'research-interests',text:en?'Research Interests':'研究兴趣'},
  {depth:2,slug:'publications',text:en?'Publications':'论文'},
  {depth:2,slug:'open-source-projects',text:en?'Open-source Projects':'开源项目'}]
const icons=['cpu','image','robot'] as const
---
<PageLayout title={en?'Academic':'学术'} {headings}>
  <h2 id='about-me'>{headings[0].text}<a class='anchor' href='#about-me'>#</a></h2>
  <Markdown source={p.background} />
  <h2 id='research-interests'>{headings[1].text}<a class='anchor' href='#research-interests'>#</a></h2>
  <div class='not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {lines(p.interests).map((interest,i)=><div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
      <div class='flex items-start gap-4'><div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'><Icon class='size-5 text-primary' name={icons[i%icons.length]} /></div>
      <div class='min-w-0 flex-1'><p class='text-lg font-medium leading-tight text-foreground'>{interest}</p>{!en&&i<2&&<p class='mt-2 text-sm leading-relaxed text-muted-foreground'>{lines(academic.en.interests)[i]}</p>}</div></div>
    </div>)}
  </div>
  <h2 id='publications'>{headings[2].text}<a class='anchor' href='#publications'>#</a></h2>
  {p.publications.length ? <ProjectItems items={p.publications} /> : <p class='text-muted-foreground'>{en?'No publications to display yet.':'暂无公开展示的论文。'}</p>}
  <h2 id='open-source-projects'>{headings[3].text}<a class='anchor' href='#open-source-projects'>#</a></h2>
  {p.projects.length ? <ProjectItems items={p.projects} /> : <p class='text-muted-foreground'>{en?'No projects to display yet.':'暂无公开展示的项目。'}</p>}
</PageLayout>
