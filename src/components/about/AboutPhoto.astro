---
import { Image } from 'astro:assets'
import lakesidePhoto from '@/assets/photos/cyril-fan-lakeside.webp'

const en = Astro.currentLocale === 'en'
---

<figure class='about-photo not-prose'>
  <Image
    src={lakesidePhoto}
    alt={en ? 'Cyril Fan standing on a wooden deck beside a lake' : '范星宇站在湖畔的木质栈台上'}
    widths={[480, 768, 1120, 1600]}
    sizes='(min-width: 1064px) 704px, (min-width: 1024px) calc(100vw - 360px), (min-width: 760px) 704px, (min-width: 640px) calc(100vw - 56px), calc(100vw - 32px)'
    format='webp'
    quality={85}
    loading='eager'
    decoding='async'
  />
</figure>

<style>
  .about-photo { width:100%; max-width:44rem; margin:1.5rem 0; }
  .about-photo :global(img) { display:block; width:100%; height:auto; border-radius:.5rem; }
</style>
