---
import config from '@/site-config'
import { Icon } from '@/components/user'
import LanguageSwitch from '@/components/user/LanguageSwitch.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
const english = Astro.currentLocale === 'en'
const brandTitle = config.header?.title || config.title
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
const menuTitles: Record<string, string> = {
  '/blog/all': english ? 'Blog' : '博客',
  '/academic': english ? 'Academic' : '学术',
  '/links': english ? 'Links' : '友链',
  '/about': english ? 'About' : '关于'
}

// Define category display names and filter allowed categories
const categoryMap: Record<string, string> = {
  'all': english ? 'All posts' : '全部文章',
  'tech': english ? 'Technical' : '技术',
  'daily': english ? 'Daily Life' : '日常',
  'research': english ? 'Research' : '科研'
}

// Define custom order (Research first)
const categoryOrder = ['all', 'research', 'tech', 'daily']

// Filter and map categories with custom order
const categories = categoryOrder
  .map(cat => ({ slug: cat, name: categoryMap[cat] }))

// 处理 trailingSlash: 'never' 配置的辅助函数
function getLocalizedUrl(locale: string | undefined, path: string) {
  let url = getRelativeLocaleUrl(locale || 'zh', path)
  // 移除尾部斜杠（除了根路径 /）
  if (url !== '/' && url.endsWith('/')) {
    url = url.slice(0, -1)
  }
  return url
}

function getAriaCurrent(link: string): 'page' | 'location' | undefined {
  const target = getLocalizedUrl(Astro.currentLocale, link)
  if (currentPath === target) return 'page'
  const section = link === '/blog/all' ? getLocalizedUrl(Astro.currentLocale, '/blog') : target
  return currentPath.startsWith(`${section}/`) ? 'location' : undefined
}
---

<header-component
  data-locale={english ? 'en' : 'zh'}
  class='group sticky top-4 z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl [&.not-top]:border-border [&.not-top]:px-1.5 md:[&.not-top]:bg-background/60 md:[&.not-top]:backdrop-blur-md dark:md:[&.not-top]:bg-muted/60'
>
  <a
    class='header-brand z-30 min-w-0 text-xl font-semibold group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href={getLocalizedUrl(Astro.currentLocale, '/')}
    aria-label={english ? `${brandTitle} home` : `${brandTitle}，返回首页`}>{brandTitle}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='header-navigation'
      role='navigation'
      aria-label={english ? 'Main navigation' : '主导航'}
    >
      <div class='flex flex-col items-center justify-center md:flex-row'>
        {
          (config.header?.menu || []).map((item) => {
            const isBlogMenu = item.link === '/blog/all'
            if (isBlogMenu && categories.length > 0) {
              return (
                <div class='menu-item-with-dropdown relative w-full md:w-fit'>
                  <a
                    href={getLocalizedUrl(Astro.currentLocale, item.link)}
                    class='blog-menu-link hidden items-center gap-1.5 px-3 py-2 font-medium hover:text-primary md:flex'
                    aria-current={getAriaCurrent(item.link)}
                  >
                    <span>{menuTitles[item.link] || item.title}</span>
                    <Icon name='chevron-down' class='chevron-icon' />
                  </a>
                  <button
                    type='button'
                    class='blog-disclosure flex w-full items-center justify-end gap-1.5 py-2 font-medium md:hidden'
                    aria-expanded='false'
                    aria-controls='blog-categories'
                  >
                    <Icon name='chevron-down' class='chevron-icon' />
                    <span>{menuTitles[item.link] || item.title}</span>
                  </button>
                  {/* Dropdown menu */}
                  <div id='blog-categories' class='dropdown-menu md:absolute md:start-0 md:top-full md:z-10 md:w-48 md:rounded-xl md:border md:border-border md:bg-background/80 md:shadow-lg md:backdrop-blur-md dark:md:bg-muted/80'>
                    <div class='category-list md:py-1'>
                      {categories.map((category) => (
                        <>
                          <a
                            href={getLocalizedUrl(Astro.currentLocale, `/blog/${category.slug}`)}
                            aria-current={getAriaCurrent(`/blog/${category.slug}`)}
                            data-all-posts={category.slug === 'all' || undefined}
                            class='category-link block text-sm transition-colors hover:text-primary md:px-4 md:py-2 md:hover:bg-background/60 dark:md:hover:bg-muted/60'
                          >
                            {category.name}
                          </a>
                          {category.slug === 'all' && <hr class='category-divider' />}
                        </>
                      ))}
                    </div>
                  </div>
                </div>
              )
            }
            
            return (
              <a
                href={getLocalizedUrl(Astro.currentLocale, item.link)}
                class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary md:w-fit md:px-3'
                aria-current={getAriaCurrent(item.link)}
              >
                {menuTitles[item.link] || item.title}
              </a>
            )
          })
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 md:w-fit md:gap-x-5'>
          <a class='header-search px-1 py-2 transition-none md:px-2' href={getLocalizedUrl(Astro.currentLocale, '/search')} title={english ? 'Search' : '站内搜索'} aria-current={getAriaCurrent('/search')}>
            <span class='sr-only'>{english ? 'Search' : '站内搜索'}</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </div>

    <!-- buttons -->
    <div class='header-controls z-30 flex items-center gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <LanguageSwitch />
      <button
        id='toggleDarkMode'
        type='button'
        title={english ? 'Change color theme' : '切换明暗主题'}
        class='inline-flex items-center justify-center box-content size-5 rounded-md border p-1.5 transition-colors hover:bg-border hover:text-primary md:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only' data-theme-label>{english ? 'Change color theme' : '切换明暗主题'}</span>
        <Icon class='system size-5' name='computer' />
        <Icon class='light hidden size-5' name='sun' />
        <Icon class='dark hidden size-5' name='moon' />
      </button>
      <button
        id='toggleMenu'
        type='button'
        title={english ? 'Open navigation' : '展开导航'}
        aria-controls='header-navigation'
        aria-expanded='false'
        class='rounded-md border p-1.5 transition-colors hover:bg-border md:hidden md:group-[.not-top]:rounded-xl'
      >
        <span class='sr-only' data-menu-label>{english ? 'Open navigation' : '展开导航'}</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = document.documentElement.dataset.theme || 'system'
  }
</script>
<script>
  import { getTheme, setTheme, showToast } from '@/utils'

  class Header extends HTMLElement {
    private eventController?: AbortController

    connectedCallback() {
      this.eventController?.abort()
      this.eventController = new AbortController()
      const { signal } = this.eventController
      const english = this.dataset.locale === 'en'

      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 600 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      }, { passive: true, signal })

      // Dark Mode
      const darkModeBtn = this.querySelector<HTMLButtonElement>('#toggleDarkMode')
      const themes = ['system', 'dark', 'light']
      const themeNames: Record<string, string> = english
        ? { system: 'system', dark: 'dark', light: 'light' }
        : { system: '跟随系统', dark: '深色', light: '浅色' }
      const updateThemeLabel = (theme: string) => {
        if (!darkModeBtn) return
        darkModeBtn.dataset.theme = theme
        const next = themes[(themes.indexOf(theme) + 1) % themes.length]
        const label = english
          ? `Color theme: ${themeNames[theme]}. Switch to ${themeNames[next]}.`
          : `当前配色：${themeNames[theme]}。切换到${themeNames[next]}。`
        darkModeBtn.setAttribute('title', label)
        const labelElement = darkModeBtn.querySelector('[data-theme-label]')
        if (labelElement) labelElement.textContent = label
      }
      updateThemeLabel(getTheme())
      darkModeBtn?.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true)
        if (!newTheme) return
        updateThemeLabel(newTheme)
        showToast({ message: english ? `Theme: ${themeNames[newTheme]}.` : `已切换为${themeNames[newTheme]}。` })
      }, { signal })

      // Menu
      const menuButton = this.querySelector<HTMLButtonElement>('#toggleMenu')
      const blogButton = this.querySelector<HTMLButtonElement>('.blog-disclosure')
      const setMenu = (expanded: boolean, restoreFocus = false) => {
        this.classList.toggle('expanded', expanded)
        menuButton?.setAttribute('aria-expanded', String(expanded))
        if (!expanded) blogButton?.setAttribute('aria-expanded', 'false')
        const label = english
          ? (expanded ? 'Close navigation' : 'Open navigation')
          : (expanded ? '收起导航' : '展开导航')
        menuButton?.setAttribute('title', label)
        const labelElement = menuButton?.querySelector('[data-menu-label]')
        if (labelElement) labelElement.textContent = label
        if (restoreFocus) menuButton?.focus()
      }
      setMenu(false)
      menuButton?.addEventListener('click', () => setMenu(!this.classList.contains('expanded')), { signal })
      blogButton?.addEventListener('click', () => {
        blogButton.setAttribute('aria-expanded', String(blogButton.getAttribute('aria-expanded') !== 'true'))
      }, { signal })
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) {
          event.preventDefault()
          setMenu(false, true)
        }
      }, { signal })
      document.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Node && !this.contains(event.target)) setMenu(false)
      }, { signal })
      this.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a[href]')) setMenu(false)
      }, { signal })
      this.addEventListener('focusout', (event) => {
        if (event.relatedTarget instanceof Node && !this.contains(event.relatedTarget)) setMenu(false)
      }, { signal })
      window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
        if (event.matches) setMenu(false)
      }, { signal })
    }

    disconnectedCallback() {
      this.eventController?.abort()
      this.eventController = undefined
    }
  }

  if (!customElements.get('header-component')) customElements.define('header-component', Header)
</script>

<style>
  .category-divider {
    margin: 0 .75rem;
    border: 0;
    border-top: 1px solid hsl(var(--border));
  }
  .category-link[data-all-posts] {
    padding-block: .75rem;
  }
  .category-divider + .category-link {
    padding-top: .75rem;
  }
  .header-brand {
    font-family: 'Century Gothic', 'ComicShannsMono', 'Satoshi', ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
    padding-inline-end: .65rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  header-component {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
    font-weight: 500;
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s,
      backdrop-filter 0.15s;

    &.not-top {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded):not(:focus-within) {
      transform: translateY(-5rem);
    }
  }

  header-component :is(a, button):focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
    border-radius: 0.375rem;
  }

  header-component a[aria-current]:not(.category-link) {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
 

  /* The bar and its drawer are separate glass layers. Filtering the sticky
     parent would stop the drawer from sampling the page behind it. */
  @media (max-width: 767.98px) {
    header-component { --nav-gutter: 1rem; }
    header-component:is(.not-top, .expanded)::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      pointer-events: none;
    }
    header-component.expanded:not(.not-top)::before {
      inset: -1rem calc(-1 * var(--nav-gutter) - 1px) -1px;
      border-radius: 0;
    }
    #header-navigation {
      display: none;
      position: absolute;
      inset-inline: calc(-1 * var(--nav-gutter) - 1px);
      inset-block-start: 100%;
      max-block-size: calc(100dvh - 5rem);
      overflow-y: auto;
      padding: .25rem var(--nav-gutter) .75rem;
      border-bottom: 1px solid hsl(var(--border));
    }
    .expanded #header-navigation { display: block; }
    .not-top #header-navigation {
      inset-inline: -1px;
      margin-block-start: .25rem;
      padding: .5rem 1rem;
      border: 1px solid hsl(var(--border));
      border-radius: .75rem;
      box-shadow: 0 10px 15px -3px rgb(24 24 27 / .12);
    }
    header-component:is(.not-top, .expanded)::before,
    #header-navigation {
      background-color: hsl(var(--background));
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
    }
    @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      header-component:is(.not-top, .expanded)::before,
      #header-navigation { background-color: hsl(var(--background) / .72); }
    }
  }
  @media (min-width: 640px) and (max-width: 767.98px) {
    header-component { --nav-gutter: 1.75rem; }
  }

  /* dark light mode toggle */
  /* Match the theme's actual 34px controls; Icon's em sizing must not override them. */
  #toggleDarkMode, #toggleMenu { box-sizing:border-box;width:34px;height:34px;padding:6px;align-items:center;justify-content:center;flex:none;position:relative; }
  #toggleDarkMode :global(svg), #toggleMenu :global(svg), .header-search :global(svg) { width:20px;height:20px;display:block;flex:none; }
  #toggleDarkMode :global(svg) { color:inherit; }
  #toggleDarkMode :global(svg.hidden) { display:none; }
  .header-search { display:flex;align-items:center;justify-content:center;min-width:36px;height:36px;box-sizing:border-box; }
  @media(pointer:coarse) { #toggleDarkMode::after,#toggleMenu::after { content:'';position:absolute;inset:-5px; } }
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }

  .menu-item-with-dropdown :global(svg.chevron-icon) {
    display: block;
    width: 1rem;
    height: 1rem;
    flex: none;
    transition: transform .2s ease;
  }

  @media (min-width: 768px) {
    .dropdown-menu {
      opacity: 0;
      visibility: hidden;
      translate: 0 -.375rem;
      transition: opacity .2s ease, translate .2s ease, visibility .2s;
    }
    .menu-item-with-dropdown:is(:hover, :focus-within) .dropdown-menu {
      opacity: 1;
      visibility: visible;
      translate: 0;
    }
    .menu-item-with-dropdown:is(:hover, :focus-within) .blog-menu-link :global(svg.chevron-icon) {
      transform: rotate(180deg);
    }
  }

  @media (max-width: 767.98px) {
    .dropdown-menu, .category-divider { display: none; }
    .blog-disclosure[aria-expanded='true'] + .dropdown-menu { display: block; }
    .blog-disclosure[aria-expanded='true'] { color: hsl(var(--primary)); }
    .blog-disclosure[aria-expanded='true'] :global(svg.chevron-icon) { transform: rotate(180deg); }
    .category-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .25rem;
      margin-block: .25rem .5rem;
      padding-inline: clamp(.25rem, 25vw - 5rem, 1.75rem);
      align-items: center;
      text-align: center;
    }
    .category-list > .category-link:first-child { text-align: start; }
    .category-list > .category-link:last-child { text-align: end; }
    .dropdown-menu .category-link { padding: .55rem 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-menu, .menu-item-with-dropdown :global(svg.chevron-icon) { transition: none; }
  }
</style>
