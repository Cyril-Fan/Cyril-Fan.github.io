---
import CommentAuth from './CommentAuth.astro'
import { commentThread } from '../../lib/comment-utils'
interface Props { thread?: string; class?: string }
const lang = Astro.currentLocale === 'en' ? 'en' : 'zh'
const en = lang === 'en'
const thread = commentThread(Astro.props.thread ?? Astro.url.pathname)
---
<site-comments id='comments' data-thread={thread} data-lang={lang} class:list={['not-prose comment-panel', Astro.props.class]} data-pagefind-ignore>
  <header class='comment-heading'>
    <h2>{en ? 'Conversation' : '留言与交流'}</h2>
    <p>{en ? 'Thoughts, questions, and friendly conversations are welcome.' : '欢迎分享想法、提出问题，也欢迎来打个招呼。'}</p>
  </header>
  <div data-unconfigured>
    <p>{en ? 'The comment service is being prepared. You can reach me by email in the meantime.' : '留言服务正在准备中，暂时欢迎通过邮箱与我交流。'}</p>
    <a href='mailto:1943480241@qq.com'>1943480241@qq.com</a>
  </div>
  <div data-configured hidden>
    <CommentAuth lang={lang} />
    <div data-login-prompt hidden class='comment-login-prompt'>
      <p>{en ? 'Join the conversation' : '一起聊聊吧'}<span>{en ? 'Sign in with a verified email to leave a comment.' : '验证邮箱并登录后，就可以留言和回复。'}</span></p>
      <button type='button' data-sign-in>{en ? 'Sign in to comment' : '登录后留言'}</button>
    </div>
    <div data-compose-home><form data-compose hidden>
      <div data-identity class='comment-identity' hidden>
        <span data-identity-avatar class='comment-avatar' aria-hidden='true'></span>
        <strong data-identity-name></strong><span data-owner-badge class='comment-badge' hidden>{en ? 'Site owner' : '站长'}</span>
        <button type='button' data-profile-edit class='comment-text-button'>{en ? 'Edit nickname' : '修改昵称'}</button>
      </div>
      <div data-profile-editor hidden class='comment-profile-editor'>
        <label>{en ? 'Public nickname' : '公开昵称'}<input name='nickname' maxlength='40' autocomplete='nickname' aria-describedby='comment-name-hint' /></label>
        <p id='comment-name-hint' data-profile-hint class='comment-note'></p>
        <div class='comment-profile-actions'><button type='button' data-profile-save>{en ? 'Save nickname' : '保存昵称'}</button><button type='button' data-profile-cancel>{en ? 'Cancel' : '取消'}</button></div>
      </div>
      <div data-reply hidden class='comment-reply-preview'><div><span></span><p data-reply-excerpt></p></div><button type='button' data-cancel-reply>{en ? 'Cancel reply' : '取消回复'}</button></div>
      <label class='comment-body-label'>{en ? 'Your comment' : '留言内容'}<textarea name='body' rows='3' maxlength='2000' required placeholder={en ? 'Share a thought or say hello…' : '分享想法，或来打个招呼…'} aria-describedby='comment-guide'></textarea></label>
      <div class='comment-compose-foot'><div class='comment-compose-meta'><span data-counter aria-live='off'>0 / 2000</span><span class='comment-shortcut'>{en ? 'Ctrl / ⌘ + Enter to post' : 'Ctrl / ⌘ + Enter 发布'}</span></div><button type='submit' data-submit disabled>{en ? 'Post comment' : '发布留言'}</button></div>
      <p id='comment-guide' class='comment-note'>{en ? 'Plain text · Email stays private · Deleting your comment keeps other people’s replies.' : '纯文本留言 · 邮箱不公开 · 删除留言会保留他人的回复'} <a href={en ? '/en/terms/privacy-policy' : '/terms/privacy-policy'}>{en ? 'Privacy' : '隐私说明'}</a></p>
    </form></div>
    <details data-admin hidden class='comment-admin'><summary>{en ? 'Comment settings' : '留言管理设置'}</summary><label><input type='checkbox' data-moderation /> {en ? 'Review new comments before publishing' : '新评论先审核再公开'}</label></details>
    <div data-status-home><p data-status role='status' aria-live='polite'></p></div>
    <div class='comment-list-heading'><h3>{en ? 'Recent comments' : '最近留言'}</h3><button type='button' data-refresh>{en ? 'Refresh' : '刷新'}</button></div>
    <ol data-list class='comment-list'></ol>
    <p data-empty hidden class='comment-empty'>{en ? 'No comments yet. Be the first to say hello.' : '这里还很安静，来留下第一声问候吧。'}</p>
    <button type='button' data-more hidden>{en ? 'Load earlier comments' : '加载更早的留言'}</button>
  </div>
  <noscript>{en ? 'JavaScript is needed to load comments. You can also contact me by email.' : '留言功能需要启用 JavaScript，也可通过邮箱联系我。'}</noscript>
  <dialog aria-labelledby='comment-confirm-title'><form method='dialog'>
    <h3 id='comment-confirm-title'></h3><p data-confirm-description></p>
    <div class='comment-dialog-actions'><button value='cancel'>{en ? 'Cancel' : '取消'}</button><button value='confirm' data-confirm-button>{en ? 'Confirm' : '确认'}</button></div>
  </form></dialog>
</site-comments>
<script>
  import '../../lib/comments'
</script>
<style is:global>
  site-comments { display:block; padding:clamp(1.2rem,3vw,2rem); border:1px solid hsl(var(--border)); border-radius:1rem; background:hsl(var(--background)); }
  site-comments [hidden] { display:none !important; }
  site-comments h2 { font-size:1.35rem; font-weight:600; margin:0 0 .5rem; }
  site-comments h3 { font-weight:600; }
  site-comments p { margin:.65rem 0; }
  site-comments .comment-heading > p, site-comments .comment-note, site-comments [data-counter], site-comments time { color:hsl(var(--muted-foreground)); font-size:.875rem; }
  site-comments label { display:block; font-size:.9rem; margin:.85rem 0; }
  site-comments input:not([type=checkbox]), site-comments textarea { display:block; width:100%; margin-top:.4rem; padding:.7rem .85rem; border:1px solid hsl(var(--border)); border-radius:.5rem; background:hsl(var(--background)); color:hsl(var(--foreground)); font:inherit; }
  site-comments textarea { resize:vertical; min-height:6.5rem; line-height:1.65; }
  site-comments button { padding:.5rem .8rem; border:1px solid hsl(var(--border)); border-radius:.5rem; font:inherit; font-size:.875rem; cursor:pointer; }
  site-comments button:hover:not(:disabled) { background:hsl(var(--muted)); }
  site-comments button:disabled { opacity:.55; cursor:not-allowed; }
  site-comments :is(button,a,input,textarea,summary):focus-visible { outline:2px solid hsl(var(--foreground)); outline-offset:3px; }
  site-comments [data-submit], site-comments [data-confirm-button] { background:hsl(var(--foreground)); color:hsl(var(--background)); }
  site-comments [data-submit]:hover:not(:disabled), site-comments [data-confirm-button]:hover { background:hsl(var(--foreground) / .85); }
  site-comments a { text-decoration:underline; text-underline-offset:3px; }
  site-comments .comment-compose-foot, site-comments .comment-list-heading, site-comments .comment-dialog-actions { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  site-comments .comment-list-heading { margin:1.5rem 0 .5rem; }
  site-comments .comment-list { padding:0; list-style:none; }
  site-comments .comment-item { border-top:1px solid hsl(var(--border)); padding:1.15rem 0; overflow-wrap:anywhere; scroll-margin-top:6rem; }
  site-comments .comment-item-reply { margin-left:clamp(.75rem,3vw,2.25rem); }
  site-comments .comment-item-header { display:flex; align-items:center; gap:.55rem; flex-wrap:wrap; }
  site-comments .comment-item-header strong { font-weight:600; }
  site-comments .comment-body { white-space:pre-wrap; line-height:1.8; }
  site-comments .comment-context { border-left:2px solid hsl(var(--border)); padding-left:.7rem; font-size:.85rem; color:hsl(var(--muted-foreground)); }
  site-comments .comment-item-actions { display:flex; flex-wrap:wrap; gap:.4rem; margin-top:.6rem; }
  site-comments .comment-item-actions button { border-color:transparent; padding:.25rem .5rem; color:hsl(var(--muted-foreground)); }
  site-comments .comment-badge { font-size:.75rem; border:1px solid hsl(var(--border)); border-radius:.3rem; padding:.1rem .35rem; }
  site-comments [data-status]:empty { display:none; }
  site-comments [data-status] { background:hsl(var(--muted)); border-radius:.5rem; padding:.7rem .9rem; font-size:.9rem; }
  site-comments [data-status][data-error=true] { border-left:3px solid #c35757; }
  site-comments [data-reply] { padding:.65rem .8rem; border-radius:.5rem; background:hsl(var(--muted)); }
  site-comments .comment-admin { margin:1rem 0; color:hsl(var(--muted-foreground)); font-size:.85rem; }
  site-comments .comment-admin summary { cursor:pointer; width:fit-content; padding:.35rem 0; }
  site-comments .comment-admin label { margin:.5rem 0; }
  site-comments [data-compose] { margin-top:1rem; padding:1rem; border:1px solid hsl(var(--border)); border-radius:.75rem; }
  site-comments .comment-compose-reply { margin-top:.8rem; background:hsl(var(--muted) / .22); }
  site-comments .comment-identity { display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; font-size:.9rem; }
  site-comments .comment-identity strong { font-weight:600; }
  site-comments .comment-avatar { display:inline-flex; flex:none; align-items:center; justify-content:center; width:2rem; height:2rem; border-radius:50%; background:hsl(var(--muted)); color:hsl(var(--muted-foreground)); font-size:.75rem; font-weight:600; user-select:none; }
  site-comments .comment-text-button { border-color:transparent; padding:.25rem .4rem; color:hsl(var(--muted-foreground)); }
  site-comments .comment-profile-editor { padding:.7rem; border-radius:.5rem; background:hsl(var(--muted) / .5); }
  site-comments .comment-profile-editor label { margin:0; }
  site-comments .comment-profile-editor input { max-width:24rem; }
  site-comments .comment-profile-actions { display:flex; flex-wrap:wrap; gap:.5rem; }
  site-comments .comment-profile-actions button { padding:.35rem .65rem; }
  site-comments .comment-body-label { font-size:.85rem; color:hsl(var(--muted-foreground)); }
  site-comments .comment-body-label textarea { color:hsl(var(--foreground)); }
  site-comments .comment-reply-preview { display:flex; align-items:start; justify-content:space-between; gap:.5rem; font-size:.85rem; }
  site-comments .comment-reply-preview > div { min-width:0; }
  site-comments .comment-reply-preview [data-reply-excerpt] { margin:.25rem 0 0; color:hsl(var(--muted-foreground)); overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
  site-comments .comment-reply-preview button { flex:none; padding:.25rem .4rem; border-color:transparent; }
  site-comments .comment-compose-meta { display:flex; flex-wrap:wrap; align-items:center; gap:.25rem .8rem; font-size:.75rem; color:hsl(var(--muted-foreground)); }
  site-comments .comment-compose-foot [data-submit] { flex:none; }
  site-comments #comment-guide { font-size:.75rem; line-height:1.7; margin:.75rem 0 0; }
  site-comments .comment-empty { padding:1.2rem .5rem; text-align:center; color:hsl(var(--muted-foreground)); font-size:.9rem; }
  site-comments .comment-login-prompt { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.6rem; padding:1rem 0; }
  site-comments .comment-login-prompt p { margin:0; font-size:.95rem; }
  site-comments .comment-login-prompt span { display:block; margin-top:.25rem; color:hsl(var(--muted-foreground)); font-size:.85rem; }
  site-comments:has(comment-auth [data-guest]:not([hidden])) [data-login-prompt] { display:none; }
  site-comments .comment-menu { position:relative; }
  site-comments .comment-menu summary { cursor:pointer; list-style:none; padding:.25rem .5rem; border-radius:.5rem; color:hsl(var(--muted-foreground)); font-size:.875rem; }
  site-comments .comment-menu summary::-webkit-details-marker { display:none; }
  site-comments .comment-menu summary:hover { background:hsl(var(--muted)); }
  site-comments .comment-menu-choices { position:absolute; z-index:5; min-width:10rem; left:0; top:calc(100% + .25rem); display:flex; flex-direction:column; align-items:stretch; gap:.15rem; padding:.35rem; border:1px solid hsl(var(--border)); border-radius:.6rem; background:hsl(var(--background)); box-shadow:0 4px 16px rgb(0 0 0 / .1); }
  site-comments .comment-menu-choices button { text-align:start; white-space:nowrap; }
  @media (max-width:480px) {
    site-comments { padding:1rem; }
    site-comments [data-compose] { padding:.75rem; }
    site-comments .comment-item-header time { flex-basis:100%; padding-left:2.55rem; font-size:.75rem; }
    site-comments .comment-shortcut { display:none; }
    site-comments .comment-item-actions button, site-comments .comment-menu summary { min-height:2.5rem; display:inline-flex; align-items:center; }
    site-comments .comment-compose-foot { gap:.5rem; }
  }
  site-comments dialog { width:min(90vw,28rem); padding:1.5rem; border:1px solid hsl(var(--border)); border-radius:1rem; color:hsl(var(--foreground)); background:hsl(var(--background)); }
  site-comments dialog::backdrop { background:rgb(0 0 0 / .45); }
  site-comments .comment-dialog-actions { justify-content:flex-end; margin-top:1.25rem; }
</style>
