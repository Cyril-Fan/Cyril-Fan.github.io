---
import PageLayout from '@/layouts/CommonPage.astro'
import { Icon } from '@/components/user'

const headings = [
  { depth: 2, slug: 'about-me', text: 'Background' },
  { depth: 2, slug: 'research-interests', text: 'Research Interests' },
  { depth: 2, slug: 'publications', text: 'Publications & Projects' }
]

const interests = [
  { title: 'Deep Learning', icon: 'cpu' as const },
  { title: 'Multimodal Large Language Models', icon: 'image' as const },
  { title: 'AI Agents', icon: 'robot' as const }
]
---

<PageLayout title='Academic' {headings}>
  <h2 id='about-me'>Background<a class='anchor' href='#about-me'>#</a></h2>
  <p>
    I’m a Software Engineering undergraduate at Jilin University (Aug 2024 - Present).
    My research interests focus on deep learning, multimodal large language models, and AI agents.
  </p>

  <h2 id='research-interests'>
    Research Interests<a class='anchor' href='#research-interests'>#</a>
  </h2>
  <div class='not-prose grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3'>
    {interests.map((interest) => (
      <div class='group relative overflow-hidden rounded-xl border border-border bg-card p-4 transition-all hover:border-foreground/25 hover:shadow-md'>
        <div class='flex items-start gap-4'>
          <div class='flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 transition-colors group-hover:bg-primary/20'>
            <Icon class='size-5 text-primary' name={interest.icon} />
          </div>
          <p class='min-w-0 flex-1 text-lg font-medium leading-tight text-foreground'>{interest.title}</p>
        </div>
      </div>
    ))}
  </div>

  <span id='open-source-projects' aria-hidden='true'></span>
  <h2 id='publications'>Publications &amp; Projects<a class='anchor' href='#publications'>#</a></h2>
  <p class='text-muted-foreground'>No publications or projects are available to share yet. Future work will appear here.</p>
</PageLayout>
