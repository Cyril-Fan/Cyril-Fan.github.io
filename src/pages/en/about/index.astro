---
import PageLayout from '@/layouts/CommonPage.astro'
import { Button, Icon } from '@/components/user'
import config from '@/site-config'
import Comment from '@/components/advanced/Comment.astro'
import AboutPhoto from '@/components/about/AboutPhoto.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: 'About Me' },
  { depth: 2, slug: 'interests', text: 'Research Interests' },
  { depth: 2, slug: 'contact', text: 'Contact' },
  { depth: 2, slug: 'comments', text: 'Conversation' }
]
---

<PageLayout title='About' {headings}>
  <h2 id='about-me'>About Me<a class='anchor' href='#about-me'>#</a></h2>
  <AboutPhoto />
  <p>Hello, I’m Cyril Fan, an undergraduate student in Software Engineering at Jilin University. Welcome to my personal website.</p>
  <p>I enjoy exploring artificial intelligence through research and hands-on projects. This is where I share what I learn and think about.</p>

  <h2 id='interests'>Research Interests<a class='anchor' href='#interests'>#</a></h2>
  <ul>
    <li>Deep Learning</li>
    <li>Multimodal Large Language Models</li>
    <li>AI Agents</li>
  </ul>
  <Button title='Visit my academic page' class='w-fit' href='/en/academic' style='ahead' />

  <h2 id='contact'>Contact<a class='anchor' href='#contact'>#</a></h2>
  <p>Feel free to reach out by email or connect with me on GitHub.</p>
  <div class='not-prose flex flex-wrap gap-3'>
    {config.personal?.email && (
      <Button title={config.personal.email} href={`mailto:${config.personal.email}`}>
        <Icon name='email' class='size-4' slot='before' />
      </Button>
    )}
    {config.personal?.githubUsername && (
      <Button
        title={`GitHub · ${config.personal.githubUsername}`}
        href={`https://github.com/${config.personal.githubUsername}`}
        target='_blank'
        rel='noopener noreferrer'
      >
        <Icon name='github' class='size-4' slot='before' />
      </Button>
    )}
  </div>
  <Comment slot='bottom' thread='/about' class='mt-6' />
</PageLayout>
