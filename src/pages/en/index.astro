---
import { Image } from 'astro:assets'
import { Button, Card, Icon, Label } from '@/components/user'
import GitHubActivityCalendar from '@/components/home/GitHubActivityCalendar.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import BlogStats from '@/components/home/BlogStats.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB966'>
  <main class='home-layout flex w-full flex-col items-center'>
    <section class='home-profile animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='profile-heading flex flex-row items-center gap-x-6'>
        <Image
          src={avatar}
          alt='Cyril Fan’s avatar'
          class='profile-avatar h-28 w-auto shrink-0 rounded-lg border p-1 sm:h-36'
          loading='eager'
        />
        <div class='flex min-w-0 flex-col gap-y-4'>
          <h1 class='text-3xl font-bold'>{config.author_en}</h1>
          <div class='flex flex-wrap gap-x-1 gap-y-1'>
            {config.personal?.location && (
              <Label title={config.personal.location}>
                <Icon name='location' class='size-4' slot='icon' />
              </Label>
            )}
            {config.personal?.githubUsername && (
              <Label
                title='GitHub'
                as='a'
                href={`https://github.com/${config.personal.githubUsername}`}
                target='_blank'
                rel='noopener noreferrer'
              >
                <Icon name='github' class='size-4' slot='icon' />
              </Label>
            )}
            {config.personal?.email && (
              <Label title='Email' as='a' href={`mailto:${config.personal.email}`}>
                <Icon name='email' class='size-4' slot='icon' />
              </Label>
            )}
          </div>
        </div>
      </div>
    </section>

    <div id='content' class='home-content animate flex w-full min-w-0 flex-col gap-y-10'>
      <Section title='About' class='home-section'>
        <p class='text-muted-foreground'>
          Hello, I’m Cyril Fan, a Software Engineering undergraduate at Jilin University. I’m interested in deep learning, multimodal large language models, and AI agents. This is where I share learning notes, technical projects, and everyday reflections.
        </p>
        <Button title='More about me' class='w-fit self-end' href='/en/about' style='ahead' />
      </Section>
      <Section title='Education' class='home-section'>
        <Card as='a' href='https://www.jlu.edu.cn/' heading='Jilin University · JLU' subheading='Software Engineering' date='Aug 2024 - Present' />
      </Section>
      <Section title='Statistics' class='home-section'>
        <BlogStats blogStartDate={new Date(config.personal?.blogStartDate || '2026-10-18')} />
      </Section>
      {config.personal?.githubUsername && (
        <GitHubActivityCalendar username={config.personal.githubUsername} />
      )}
    </div>
  </main>
</PageLayout>

<style>
  @media (min-width: 1024px) {
    .home-layout {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      align-items: start;
      gap: 3rem;
    }
    .home-profile { position: sticky; top: 7rem; margin-bottom: 0; align-items: flex-start; }
    .profile-heading { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .profile-avatar { width: 11rem; height: 11rem; object-fit: cover; }
    .home-content :global(.home-section) { flex-direction: column; gap: 1rem; }
  }
</style>
