---
import PageLayout from '@/layouts/CommonPage.astro'
import { Button, Icon } from '@/components/user'
import config from '@/site-config'
import Comment from '@/components/advanced/Comment.astro'

const headings = [
  { depth: 2, slug: 'about-me', text: '关于我' },
  { depth: 2, slug: 'on-this-site', text: '在这里' },
  { depth: 2, slug: 'contact', text: '联系我' }
]
---

<PageLayout title='关于' {headings}>
  <h2 id='about-me'>关于我<a class='anchor' href='#about-me'>#</a></h2>
  <p>你好，我是范星宇，正在吉林大学学习软件工程。我喜欢通过研究和动手实践探索人工智能，也在这里记录学习过程。</p>

  <h2 id='on-this-site'>在这里<a class='anchor' href='#on-this-site'>#</a></h2>
  <p>博客收录学习笔记、技术实践和生活记录；学术页整理研究兴趣与后续可公开的工作。文章会随学习过程持续修订，欢迎指出疏漏或在下方留言交流。</p>
  <Button title='查看学术主页' class='w-fit' href='/academic' style='ahead' />

  <h2 id='contact'>联系我<a class='anchor' href='#contact'>#</a></h2>
  <p>欢迎通过邮件或 GitHub 与我交流。</p>
  <div class='not-prose flex flex-wrap gap-3'>
    {config.personal?.email && (
      <Button title={config.personal.email} href={`mailto:${config.personal.email}`}>
        <Icon name='email' class='size-4' slot='before' />
      </Button>
    )}
    {config.personal?.githubUsername && (
      <Button
        title={`GitHub · ${config.personal.githubUsername}`}
        href={`https://github.com/${config.personal.githubUsername}`}
        target='_blank'
        rel='noopener noreferrer'
      >
        <Icon name='github' class='size-4' slot='before' />
      </Button>
    )}
  </div>
  <Comment slot='bottom' thread='/about' class='mt-6' />
</PageLayout>
