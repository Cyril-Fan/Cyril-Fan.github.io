---
import { PostPreview } from '@/components/pages'
import { getBlogCollection, groupCollectionsByYear, sortMDByDate } from '@/server'
import { Button } from '@/components/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts)
const allPostsByYear = groupCollectionsByYear(allPostsByDate)

const meta = {
  description: '按年份浏览本站发布的文章',
  title: '文章归档'
}
---

<PageLayout {meta}>
  <Button title='返回首页' href='/' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>文章归档</h1>
    </div>

    {allPosts.length === 0 && (
      <div class='rounded-xl border border-border bg-card px-6 py-10 text-center'>
        <h2 class='text-xl font-medium'>暂无文章</h2>
        <p class='mt-3 text-muted-foreground'>发布后的文章会在这里按年份整理。</p>
      </div>
    )}

    <section id='content' class='animate' aria-label='文章列表'>
      {
        allPostsByYear.map(([year, posts]) => (
          <div class='relative mt-20'>
            <h2
              class='absolute -start-6 -top-16 z-0 text-9xl font-bold text-transparent opacity-10'
              style='-webkit-text-stroke-width:2px;-webkit-text-stroke-color:hsl(var(--foreground)/var(--tw-text-opacity,1))'
            >
              <samp>{year}</samp>
            </h2>
            <p class='px-5 text-muted-foreground'>
              {posts.length} 篇文章
            </p>
            <ul class='flex flex-col text-start'>
              {posts.map((p) => (
                <PostPreview post={p} class='border-0 bg-transparent py-2' />
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </main>
</PageLayout>
