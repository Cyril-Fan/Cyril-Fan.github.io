---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview, CollectionPreview } from '@/components/pages'
import { getBlogCollection, getUniqueCategories, getUniqueTags, sortMDByDate, getPostCollections } from '@/server'
import { Button, Icon } from '@/components/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const categoryMap: Record<string, string> = {
    'tech': '技术',
    'daily': '日常',
    'research': '科研',
    'technical': '技术',
    'life': '日常',
    'all': '全部文章'
  }
  const aliases: Record<string, string> = {
    technical: 'tech',
    life: 'daily',
    journal: 'daily',
    'month-journal': 'daily'
  }
  const normalizeCategory = (category: string) => aliases[category] || category
  const categoryOrder = ['research', 'tech', 'daily', 'all']
  const allCollections = await getBlogCollection()
  const allUniqueCategories = getUniqueCategories(allCollections).map(normalizeCategory)
  const navigationCategories = [...new Set([...categoryOrder, ...allUniqueCategories])]
  const uniqueCategories = [...new Set([...navigationCategories, 'technical', 'life'])]

  return uniqueCategories.flatMap((category) => {
    const normalizedCategory = normalizeCategory(category)
    const collections = sortMDByDate(category === 'all'
      ? allCollections
      : allCollections.filter((post) => normalizeCategory(post.data.category || '') === normalizedCategory))
    const uniqueTags = getUniqueTags(collections)
    const collectionsCount = collections.length
    
    // Get previous and next categories (circular navigation)
    const navigationIndex = navigationCategories.indexOf(normalizedCategory)
    const prevCategory = navigationCategories[(navigationIndex - 1 + navigationCategories.length) % navigationCategories.length]
    const nextCategory = navigationCategories[(navigationIndex + 1) % navigationCategories.length]
    const props = { uniqueTags, collectionsCount, category, prevCategory, nextCategory, categoryMap }
    const pageSize = config.content?.blogPageSize || 8

    if (collections.length === 0) {
      const page: Page<CollectionEntry<'blog'>> = {
        data: [], start: 0, end: 0, total: 0, size: pageSize, currentPage: 1, lastPage: 1,
        url: { current: `/blog/${category}`, prev: undefined, next: undefined, first: undefined, last: undefined }
      }
      return [{ params: { category, page: undefined }, props: { ...props, page } }]
    }

    return paginate(collections, {
      params: { category },
      pageSize,
      props
    })
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  collectionsCount: number
  category: string
  prevCategory: string
  nextCategory: string
  categoryMap: Record<string, string>
}

const { page, uniqueTags, collectionsCount, category, prevCategory, nextCategory, categoryMap: categoryMapProp } = Astro.props

const categoryDisplayName = categoryMapProp[category] || category
const postCollections = await getPostCollections()

const meta = {
  description: `浏览“${categoryDisplayName}”分类下的文章`,
  title: `${categoryDisplayName} - 博客`
}
---

<PageLayout {meta}>
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='category-nav-wrapper mb-6 mt-6 sm:mt-10'>
        <h1 class='inline-block text-3xl font-medium'>{categoryDisplayName}</h1>
        <div class='category-nav-arrows ml-3 inline-flex gap-1 align-middle'>
          <a 
            href={`/blog/${prevCategory}`}
            class='flex h-8 w-8 items-center justify-center transition-colors hover:text-primary'
            title={`上一个分类：${categoryMapProp[prevCategory] || prevCategory}`}
            aria-label={`前往${categoryMapProp[prevCategory] || prevCategory}分类`}
          >
            <Icon name='up' class='size-5' />
          </a>
          <a 
            href={`/blog/${nextCategory}`}
            class='flex h-8 w-8 items-center justify-center transition-colors hover:text-primary'
            title={`下一个分类：${categoryMapProp[nextCategory] || nextCategory}`}
            aria-label={`前往${categoryMapProp[nextCategory] || nextCategory}分类`}
          >
            <Icon name='chevron-down' class='size-5' />
          </a>
        </div>
      </div>
    </div>
    {
      page.data.length === 0 ? (
        <section id='content' class='animate rounded-xl border border-border bg-card px-6 py-10 text-center'>
          <h2 class='text-xl font-medium'>暂无文章</h2>
          <p class='mt-3 text-muted-foreground'>后续将在这里分享科研、技术与日常记录。</p>
          <a class='mt-6 inline-block text-sm hover:text-primary' href='/archives'>查看文章归档 →</a>
        </section>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='文章列表' class='animate' id='content'>
            {/* header */}
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                第 {page.currentPage} 页 · 本页 {page.data.length} 篇，共 {collectionsCount} 篇文章
              </span>
              <a aria-label='按年份浏览全部文章' href='/archives' data-astro-prefetch>
                按年份浏览全部文章 →
              </a>
            </div>
            {/* posts */}
            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <PostPreview {post} detailed />
              ))}
            </ul>
            <Paginator currentPage={page.currentPage} lastPage={page.lastPage} url={page.url} />
          </section>

          {/* sidebar */}
          {(!!uniqueTags.length || !!postCollections.length) && (
            <aside class='animate' id='sidebar'>
              {!!postCollections.length && (
                <div class='mb-8'>
                  <h2 class='mb-4 flex items-center text-lg font-semibold'>
                    <Icon name='package' class='me-2' />
                    文章合集
                  </h2>
                  <ul class='flex flex-col gap-2'>
                    {postCollections.slice(0, 5).map((collection) => (
                      <CollectionPreview {collection} minimal />
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                      <a aria-label='查看全部文章合集' href='/collection' data-astro-prefetch>
                      查看全部 →
                      </a>
                  </span>
                </div>
              )}
              {!!uniqueTags.length && (
                <div>
                  <h2 class='mb-4 flex items-center text-lg font-semibold'>
                    <Icon name='tag-2' class='me-2' />
                    标签
                  </h2>
                  <ul class='text-bgColor flex flex-wrap gap-2'>
                    {uniqueTags.map((tag) => (
                      <li>
                        <Button title={tag} href={`/tags/${tag}`} style='pill' />
                      </li>
                    ))}
                  </ul>
                  <span class='mt-4 block sm:text-end'>
                    <a aria-label='查看全部文章标签' href='/tags' data-astro-prefetch>
                      查看全部 →
                    </a>
                  </span>
                </div>
              )}
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
